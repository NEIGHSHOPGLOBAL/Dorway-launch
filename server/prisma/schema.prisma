generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---- Accounts -------------------------------------------------------

enum OnboardingStep {
  IDENTIFIED
  PROFILED
  PLAN_SELECTED
  PAYING
  PAID
  SETUP_STARTED
  SETUP_SUBMITTED
  PROVISIONED
  ACTIVE
}

model User {
  id                   String         @id @default(uuid())
  email                String?        @unique
  phone                String?        @unique
  phoneVerified        Boolean        @default(false) @map("phone_verified")
  fullName             String?        @map("full_name")
  businessName         String?        @map("business_name")
  businessCity         String?        @map("business_city")
  gstin                String?
  billingStateCode     String?        @map("billing_state_code")
  emailVerified        Boolean        @default(false) @map("email_verified")
  onboardingStep       OnboardingStep @default(IDENTIFIED) @map("onboarding_step")
  onboardingUpdatedAt  DateTime       @default(now()) @updatedAt @map("onboarding_updated_at")
  createdAt            DateTime       @default(now()) @map("created_at")
  lastLoginAt          DateTime?      @map("last_login_at")
  // userchanges.md L-5 — consent to Terms/Privacy + WhatsApp account messages,
  // captured once at first signup.
  consentAt            DateTime?      @map("consent_at")

  // superadmin.md §1.2, §12 — excluded from every metric unless the
  // "include test accounts" toggle is on.
  isTest      Boolean @default(false) @map("is_test")
  source      String? // direct | partner | utm
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  device      String? // mobile | desktop, captured at signup
  signupIp    String? @map("signup_ip") // superadmin.md §7.7 signup-burst rule

  orders             Order[]
  entitlements       Entitlement[]
  onboardingProfile  OnboardingProfile?
  onboardingDocuments OnboardingDocument[]
  referral           Referral?
  onboardingEvents   OnboardingEvent[]
  funnelEvents       FunnelEvent[]

  @@map("users")
}

// userchanges.md §9 — a separate, append-*every-time* event stream for UI
// funnel events (PREVIEW_VIEWED, PAYWALL_OPENED, TERM_SELECTED, ...).
// OnboardingEvent above is first-occurrence-per-step and already drives the
// admin account-progress funnel — this is additive, not a replacement.
model FunnelEvent {
  id                String   @id @default(uuid())
  userId            String?  @map("user_id")
  sessionId         String?  @map("session_id")
  event             String
  meta              Json?
  referralPartnerId String?  @map("referral_partner_id")
  utmSource         String?  @map("utm_source")
  utmMedium         String?  @map("utm_medium")
  utmCampaign       String?  @map("utm_campaign")
  device            String?
  createdAt         DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([event, createdAt])
  @@index([userId, event])
  @@map("funnel_events")
}

// superadmin.md §5.1/§12 — append-only, first occurrence per step, powers
// the funnel, cohort table and the "stuck for" column. The step column uses
// the same OnboardingStep enum as users.onboarding_step, so funnel/timeline/
// current-state always agree — no separate hypothetical step list.
model OnboardingEvent {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  step      OnboardingStep
  createdAt DateTime       @default(now()) @map("created_at")
  meta      Json?

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, step])
  @@index([step, createdAt])
  @@map("onboarding_events")
}

model LoginOtp {
  id         String    @id @default(uuid())
  email      String?
  phone      String?
  channel    String    @default("email") // "email" | "whatsapp"
  codeHash   String    @map("code_hash")
  expiresAt  DateTime  @map("expires_at")
  attempts   Int       @default(0)
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([email, createdAt(sort: Desc)])
  @@index([phone, createdAt(sort: Desc)])
  @@map("login_otps")
}

// ---- Catalogue --------------------------------------------------------

model Plan {
  code             String   @id
  name             String
  normalPaiseMonth BigInt   @map("normal_paise_month")
  earlyPaiseMonth  BigInt   @map("early_paise_month")
  seatCap          Int?     @map("seat_cap")
  numberCap        Int      @map("number_cap")
  features         Json
  sortOrder        Int      @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")

  orders       Order[]
  entitlements Entitlement[]

  @@map("plans")
}

model LaunchConfig {
  id                  Int      @id @default(1)
  launchAt            DateTime @map("launch_at")
  earlyBirdEndsAt      DateTime @map("early_bird_ends_at")
  earlyBirdSeatCap     Int?     @map("early_bird_seat_cap")
  earlyBirdForceClose  Boolean  @default(false) @map("early_bird_force_close")
  checkoutEnabled      Boolean  @default(true) @map("checkout_enabled")
  gstPercent           Decimal  @default(18.00) @map("gst_percent") @db.Decimal(5, 2)
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("launch_config")
}

// ---- Commerce ---------------------------------------------------------

enum OrderStatus {
  CREATED
  PENDING
  PAID
  FAILED
  EXPIRED
  REFUNDED
}

model Order {
  id                    String      @id @default(uuid())
  userId                String      @map("user_id")
  planCode              String      @map("plan_code")
  termMonths            Int         @map("term_months")
  isEarlyBird           Boolean     @map("is_early_bird")
  // userchanges.md P-3 — the term-discount rate actually applied, stored so
  // invoices/admin never recompute pricing history after the rate changes.
  discountPercent       Int         @default(0) @map("discount_percent")
  savingsPaise          BigInt      @default(0) @map("savings_paise")
  // userchanges.md C-2 — "email for invoice", required at checkout.
  invoiceEmail          String?     @map("invoice_email")
  ratePaiseMonth        BigInt      @map("rate_paise_month")
  subtotalPaise         BigInt      @map("subtotal_paise")
  cgstPaise             BigInt      @default(0) @map("cgst_paise")
  sgstPaise             BigInt      @default(0) @map("sgst_paise")
  igstPaise             BigInt      @default(0) @map("igst_paise")
  placeOfSupply         String?     @map("place_of_supply")
  totalPaise            BigInt      @map("total_paise")
  currency              String      @default("INR")
  status                OrderStatus @default(CREATED)
  cfOrderId             String?     @unique @map("cf_order_id")
  cfPaymentSessionId    String?     @map("cf_payment_session_id")
  idempotencyKey        String      @unique @map("idempotency_key")
  referralId            String?     @map("referral_id")
  createdAt             DateTime    @default(now()) @map("created_at")
  paidAt                DateTime?   @map("paid_at")
  refundedAt            DateTime?   @map("refunded_at")
  expiresAt             DateTime    @map("expires_at")

  user        User         @relation(fields: [userId], references: [id])
  plan        Plan         @relation(fields: [planCode], references: [code])
  payments    Payment[]
  entitlement Entitlement?
  referral    Referral?    @relation(fields: [referralId], references: [id])
  commission  Commission?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
  @@index([referralId])
  @@map("orders")
}

model Payment {
  id          String   @id @default(uuid())
  orderId     String   @map("order_id")
  cfPaymentId String   @unique @map("cf_payment_id")
  status      String
  method      String?
  amountPaise BigInt   @map("amount_paise")
  bankRef     String?  @map("bank_ref")
  raw         Json
  createdAt   DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model WebhookEvent {
  id           String    @id @default(uuid())
  dedupeKey    String    @unique @map("dedupe_key")
  eventType    String    @map("event_type")
  signatureOk  Boolean   @map("signature_ok")
  raw          Json
  receivedAt   DateTime  @default(now()) @map("received_at")
  processedAt  DateTime? @map("processed_at")
  error        String?

  @@map("webhook_events")
}

// ---- What the customer actually bought -------------------------------

enum EntitlementStatus {
  PENDING_LAUNCH
  ACTIVE
  EXPIRED
  REFUNDED
  CANCELLED
}

// userchanges.md §8.1 — admin approval layer on top of payment. The webhook
// (Order/Entitlement creation) stays the source of truth for payment; this
// is a separate state the admin console advances.
enum ApprovalStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model Entitlement {
  id               String            @id @default(uuid())
  userId           String            @map("user_id")
  orderId          String            @unique @map("order_id")
  planCode         String            @map("plan_code")
  ratePaiseMonth   BigInt            @map("rate_paise_month")
  termMonths       Int               @map("term_months")
  accessStartsAt   DateTime          @map("access_starts_at")
  accessEndsAt     DateTime          @map("access_ends_at")
  status           EntitlementStatus @default(PENDING_LAUNCH)
  crmTenantId      String?           @map("crm_tenant_id")
  provisionedAt    DateTime?         @map("provisioned_at")
  createdAt        DateTime          @default(now()) @map("created_at")

  approvalStatus   ApprovalStatus    @default(PENDING_REVIEW) @map("approval_status")
  approvedAt       DateTime?         @map("approved_at")
  approvedBy       String?           @map("approved_by")
  rejectionReason  String?           @map("rejection_reason")
  setupOwnerName   String?           @map("setup_owner_name")
  setupOwnerPhone  String?           @map("setup_owner_phone")
  setupCallAt      DateTime?         @map("setup_call_at")

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])
  plan  Plan  @relation(fields: [planCode], references: [code])

  @@index([approvalStatus, createdAt])
  @@map("entitlements")
}

// ---- Everyone who didn't buy -----------------------------------------

model Waitlist {
  id         String   @id @default(uuid())
  email      String   @unique
  source     String?
  planIntent String?  @map("plan_intent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("waitlist")
}

// ---- Onboarding / setup ------------------------------------------------

model OnboardingProfile {
  userId              String    @id @map("user_id")

  // A: number
  waNumber            String?   @map("wa_number")
  waOnConsumerApp      Boolean?  @map("wa_on_consumer_app")
  waCurrentPlatform    String?   @map("wa_current_platform")
  waOtpReachable       String?   @map("wa_otp_reachable")

  // userchanges.md W-4 — "how many people reply to customers on WhatsApp?",
  // captured on /welcome. Personalises preview copy and is an admin segment.
  teamSize             String?   @map("team_size")

  // B: business
  legalName           String?   @map("legal_name")
  registeredAddress   String?   @map("registered_address")
  billingStateCode    String?   @map("billing_state_code")
  website             String?
  businessEmail       String?   @map("business_email")
  metaBusinessId      String?   @map("meta_business_id")
  facebookPage        String?   @map("facebook_page")
  waDisplayName       String?   @map("wa_display_name")

  // D: existing credentials (kind='wa_system_user_token' rows live in
  // tenant_credentials-style storage — see OnboardingDocument note below;
  // kept out of scope for launch per onboarding.md §13 "can wait")
  hasExistingWaba      Boolean?  @map("has_existing_waba")
  existingWabaId       String?   @map("existing_waba_id")
  existingPhoneId      String?   @map("existing_phone_id")
  existingPlatform     String?   @map("existing_platform")

  sectionADone        Boolean   @default(false) @map("section_a_done")
  sectionBDone        Boolean   @default(false) @map("section_b_done")
  sectionCDone        Boolean   @default(false) @map("section_c_done")
  submittedAt         DateTime? @map("submitted_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("onboarding_profiles")
}

model OnboardingDocument {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  kind        String   // 'incorporation' | 'address_proof' | 'pan' | 'other'
  storageKey  String   @map("storage_key")
  filename    String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  scannedOk   Boolean? @map("scanned_ok")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")

  user User @relation(fields: [userId], references: [id])

  @@map("onboarding_documents")
}

// superadmin.md §10 admin_audit_log. `actor`/`subject`/`meta` predate this
// spec (see routes/admin.ts) and stay as the general-purpose fields; the
// columns below are what every new admin write action fills in.
model AuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  subject    String?
  meta       Json?
  entityType String?  @map("entity_type")
  reason     String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actor, createdAt(sort: Desc)])
  @@index([entityType, subject])
  @@map("audit_log")
}

// superadmin.md §12 admin_notes — polymorphic by entityType/entityId
// (users or partners today), no Prisma relation since the target varies.
model AdminNote {
  id         String   @id @default(uuid())
  entityType String   @map("entity_type") // "user" | "partner"
  entityId   String   @map("entity_id")
  adminId    String   @map("admin_id")
  text       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@map("admin_notes")
}

// superadmin.md §7.7 — created only by the fraud_rules job; the panel reviews.
model FraudFlag {
  id             String    @id @default(uuid())
  partnerId      String    @map("partner_id")
  rule           String
  evidence       Json
  status         String    @default("open") // "open" | "dismissed" | "actioned"
  resolvedBy     String?   @map("resolved_by")
  resolvedReason String?   @map("resolved_reason")
  createdAt      DateTime  @default(now()) @map("created_at")
  resolvedAt     DateTime? @map("resolved_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, status])
  @@index([rule, partnerId, status])
  @@map("fraud_flags")
}

// superadmin.md §6.4 / §12 — one row per daily reconciliation run.
model ReconciliationRun {
  id            String   @id @default(uuid())
  runDate       DateTime @unique @map("run_date")
  matchedCount  Int      @map("matched_count")
  matchedAmount BigInt   @map("matched_amount")
  issues        Json
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("reconciliation_runs")
}

// ---- Partner program ---------------------------------------------------
// partners.md — frontend at web/src/pages/partners/DorwayPartners.jsx.
// Business rules (commission %, hold days, bonus shape) live in
// server/src/lib/partnerProgram.ts and are open decisions per partners.md §12;
// ship with the documented defaults, revisit once the business confirms them.

enum PartnerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

model Partner {
  id               String        @id @default(uuid())
  name             String
  phone            String        @unique
  email            String
  code             String        @unique
  status           PartnerStatus @default(ACTIVE)
  termsVersion     String        @map("terms_version")
  termsAcceptedAt  DateTime      @map("terms_accepted_at")
  whatsappOptIn    Boolean       @map("whatsapp_opt_in")
  notifyWhatsapp   Boolean       @default(true) @map("notify_whatsapp")
  notifyEmail      Boolean       @default(true) @map("notify_email")
  isTest           Boolean       @default(false) @map("is_test")
  createdAt        DateTime      @default(now()) @map("created_at")

  payoutMethod   PartnerPayoutMethod?
  referralEvents ReferralEvent[]
  referrals      Referral[]
  commissions    Commission[]
  bonuses        Bonus[]
  payouts        PartnerPayout[]
  fraudFlags     FraudFlag[]

  @@map("partners")
}

// Mirrors LoginOtp's shape/lookup pattern (most-recent-unconsumed-row,
// no separate requestId/verificationToken indirection) so partner auth
// reads the same way as the customer OTP flow in routes/auth.ts.
model PartnerOtp {
  id         String    @id @default(uuid())
  phone      String
  purpose    String    // "register" | "login"
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt(sort: Desc)])
  @@map("partner_otps")
}

model PartnerPayoutMethod {
  partnerId     String    @id @map("partner_id")
  type          String    // "upi" | "bank"
  upiId         String?   @map("upi_id")
  accountName   String?   @map("account_name")
  accountNumber String?   @map("account_number")
  ifsc          String?
  pan           String    // TODO(security): encrypt at rest before real payouts go out — see partners.md §8
  verifiedAt    DateTime? @map("verified_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@map("partner_payout_methods")
}

model ReferralEvent {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  type      String   // "link_opened" | "code_applied" | "signed_up" | "checkout_started"
  source    String   // "link" | "code"
  visitorId String?  @map("visitor_id")
  accountId String?  @map("account_id")
  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([partnerId, createdAt(sort: Desc)])
  @@map("referral_events")
}

model Referral {
  id             String    @id @default(uuid())
  partnerId      String    @map("partner_id")
  accountId      String    @unique @map("account_id")
  attributedVia  String    @map("attributed_via") // "link" | "code"
  attributedAt   DateTime  @map("attributed_at")
  status         String    @default("signed_up") // "signed_up" | "converted" | "rejected"
  rejectionReason String?  @map("rejection_reason")

  partner Partner @relation(fields: [partnerId], references: [id])
  account User    @relation(fields: [accountId], references: [id])
  orders  Order[]

  @@index([partnerId])
  @@map("referrals")
}

model Commission {
  id              String    @id @default(uuid())
  partnerId       String    @map("partner_id")
  orderId         String    @unique @map("order_id")
  amount          BigInt    // paise
  status          String    @default("on_hold") // "on_hold" | "approved" | "paid" | "reversed"
  paidAt          DateTime  @map("paid_at")
  holdUntil       DateTime  @map("hold_until")
  approvedAt      DateTime? @map("approved_at")
  reversedAt      DateTime? @map("reversed_at")
  reversalReason  String?   @map("reversal_reason")
  payoutId        String?   @map("payout_id")
  bonusId         String?   @map("bonus_id")

  partner Partner        @relation(fields: [partnerId], references: [id])
  order   Order          @relation(fields: [orderId], references: [id])
  payout  PartnerPayout? @relation(fields: [payoutId], references: [id])
  bonus   Bonus?         @relation(fields: [bonusId], references: [id])

  @@index([partnerId, status])
  @@index([bonusId])
  @@index([partnerId, paidAt])
  @@map("commissions")
}

model Bonus {
  id        String    @id @default(uuid())
  partnerId String    @map("partner_id")
  amount    BigInt    // paise
  status    String    @default("on_hold") // "on_hold" | "approved" | "paid" | "reversed"
  earnedAt  DateTime  @map("earned_at")
  holdUntil DateTime  @map("hold_until")
  approvedAt DateTime? @map("approved_at")
  payoutId  String?   @map("payout_id")

  partner     Partner        @relation(fields: [partnerId], references: [id])
  payout      PartnerPayout? @relation(fields: [payoutId], references: [id])
  commissions Commission[]

  @@index([partnerId, status])
  @@map("bonuses")
}

model PartnerPayout {
  id              String    @id @default(uuid())
  partnerId       String    @map("partner_id")
  amount          BigInt    // gross, paise
  tdsAmount       BigInt    @default(0) @map("tds_amount")
  netAmount       BigInt    @map("net_amount")
  methodSnapshot  Json      @map("method_snapshot")
  status          String    @default("requested") // "requested" | "processing" | "paid" | "rejected"
  reference       String?
  rejectionReason String?   @map("rejection_reason")
  idempotencyKey  String?   @unique @map("idempotency_key")
  requestedAt     DateTime  @default(now()) @map("requested_at")
  paidAt          DateTime? @map("paid_at")

  partner     Partner      @relation(fields: [partnerId], references: [id])
  commissions Commission[]
  bonuses     Bonus[]

  @@index([partnerId, status])
  @@map("partner_payouts")
}
